{
  "name": "ds2408",
  "version": "1.0.0",
  "description": "DS2408 1-Wire 8-channel GPIO chip access via Linux SysFS (1-wire kernel driver). Zero runtime dependencies, ESM, TypeScript types.",
  "type": "module",
  "main": "dist/ds2408.js",
  "types": "dist/ds2408.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ds2408.d.ts",
      "default": "./dist/ds2408.js"
    }
  },
  "files": [
    "dist/ds2408.js",
    "dist/ds2408.js.map",
    "dist/ds2408.d.ts",
    "dist/ds2408.d.ts.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/ds2408.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/ds2408.git"
  },
  "keywords": [
    "ds2408",
    "1-wire",
    "onewire",
    "w1",
    "gpio",
    "sysfs",
    "linux",
    "maxim",
    "dallas"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cinderblock/ds2408/issues"
  },
  "homepage": "https://github.com/cinderblock/ds2408#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
